{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@pages/*": ["./src/ui/pages/*"],
      "@actions/*": ["./src/ui/actions/*"],
      "@validations/*": ["./src/ui/validations/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "playwright.config.ts"]
}
